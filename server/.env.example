# Copy this file to .env and fill in your values
# Run: copy .env.example .env   (Windows)  OR  cp .env.example .env  (Mac/Linux)

PORT=5000
JWT_SECRET=replace-this-with-a-long-random-secret-key

# Optional: path where SQLite DB file is stored
# Leave blank for local development (uses server/src/db/ by default)
# On Render, set this to: /data
DB_PATH=
